# Config web Firebase (console > Paramètres du projet > Vos applications > Web)
# Non secret (embarqué dans le build), mais ne pas commiter .env quand même.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Scripts Node (scripts/games.mjs) : à exporter dans ton shell, pas lu par Vite ---
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/absolu/hors-repo/ludotheque-adminsdk.json
# LUDO_FAMILY=<familyId par défaut>          (optionnel)

# --- Déploiement (scripts/deploy.mjs) ---
# DEPLOY_REMOTE=origin                       (remote git ou URL)
# DEPLOY_BRANCH=deploy                       (branche suivie par Hostinger)
# HOSTINGER_DEPLOY_WEBHOOK=                  (URL "Auto deployment" de hPanel > Git, optionnel)
